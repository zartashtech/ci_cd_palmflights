APP_NAME="Palm Flights"
APP_ENV=production
APP_KEY=                          # Run: php artisan key:generate
APP_DEBUG=false
APP_URL=                          # e.g. https://www.palmflights.co.uk

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=                      # Set on server
DB_USERNAME=                      # Set on server
DB_PASSWORD=                      # Set on server

MAIL_MAILER=smtp
MAIL_HOST=                        # Set on server
MAIL_PORT=587
MAIL_USERNAME=                    # Set on server
MAIL_PASSWORD=                    # Set on server
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=                # Set on server
MAIL_FROM_NAME="${APP_NAME}"

# SMTP Debug / Alerts
SMTP_DEBUG_USERNAME=              # Set on server
SMTP_DEBUG_PASSWORD=              # Set on server

# reCAPTCHA Configuration
RECAPTCHA_V3_SECRET_KEY=          # Set on server
